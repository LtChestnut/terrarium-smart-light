(version 1)

# ---------------------------------------------------------------------------------------------
# JLCPCB 4-layer rules (1 oz outer / 0.5 oz inner), chosen to avoid surcharges.
# Source: https://jlcpcb.com/capabilities/pcb-capabilities (checked 2026-11-18).
# Board-wide minimums live in Board Setup (project file): clearance 0.1, track 0.1,
# via 0.45/0.2, via hole-to-hole 0.2, hole clearance 0.2, copper-to-edge 0.3,
# silk text 1.0 mm / 0.15 mm, solder-mask web 0.1.
# ---------------------------------------------------------------------------------------------

(rule "JLC: plated pad annular ring >= 0.15 mm"
	(condition "A.Type == 'Pad' && A.isPlated()")
	(constraint annular_width (min 0.15mm)))

(rule "JLC: pad hole to pad hole >= 0.45 mm"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLC: PTH hole to other-net copper >= 0.28 mm"
	(condition "A.Type == 'Pad' && A.isPlated() && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLC: NPTH hole >= 0.5 mm"
	(condition "A.Type == 'Pad' && !A.isPlated()")
	(constraint hole_size (min 0.5mm)))

(rule "JLC: via no-surcharge size"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.2mm))
	(constraint via_diameter (min 0.45mm)))

# ---------------------------------------------------------------------------------------------
# H1-H4 are M3 non-plated mounting holes centred on the board edge (they break out as notches),
# so exempt them from edge clearance.
# ---------------------------------------------------------------------------------------------
(rule "Mounting holes may cross board edge"
	(condition "A.memberOfFootprint('H*')")
	(constraint edge_clearance (min 0mm))
	(severity ignore))
